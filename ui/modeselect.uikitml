</style>
<div class="mode-panel">
  <span class="mode-title">GAME MODES</span>
  <span id="btn-freethrow" class="mode-btn" cursor="pointer">FREE THROW</span>
  <span class="mode-desc">Classic free throw line shooting</span>
  <span id="btn-threepoint" class="mode-btn" cursor="pointer">THREE-POINT CONTEST</span>
  <span class="mode-desc">5 racks, timed 3-point shooting</span>
  <span id="btn-arcade" class="mode-btn" cursor="pointer">ARCADE</span>
  <span class="mode-desc">Progressive difficulty, score attack</span>
  <span id="btn-horse" class="mode-btn" cursor="pointer">H.O.R.S.E.</span>
  <span class="mode-desc">Classic horse vs AI opponent</span>
  <span id="btn-trickshot" class="mode-btn" cursor="pointer">TRICK SHOTS</span>
  <span class="mode-desc">10 challenges: bank shots, swishes &amp; more</span>
  <span id="btn-daily" class="mode-btn" cursor="pointer">DAILY CHALLENGE</span>
  <span class="mode-desc">New challenge every day, same for everyone</span>
  <span id="btn-practice" class="mode-btn" cursor="pointer">PRACTICE</span>
  <span class="mode-desc">Unlimited shooting, no pressure</span>
  <span id="btn-modes-back" class="back-btn" cursor="pointer">BACK</span>
