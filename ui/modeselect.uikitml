<style>
  .mode-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 0, 0, 0.85);
    border-color: #ff6600;
    border-width: 0.12;
    border-radius: 1.5;
  }
  .mode-title {
    font-size: 3;
    color: #ff6600;
    font-weight: bold;
    margin-bottom: 2;
  }
  .mode-btn {
    font-size: 2;
    color: #ffffff;
    background-color: rgba(255, 102, 0, 0.25);
    border-color: #ff6600;
    border-width: 0.06;
    border-radius: 0.6;
    padding-top: 0.8;
    padding-bottom: 0.8;
    padding-left: 2;
    padding-right: 2;
    margin-bottom: 0.6;
    cursor: pointer;
    width: 100%;
