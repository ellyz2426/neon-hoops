  }
  .mode-desc {
    font-size: 1.2;
    color: #888888;
    margin-bottom: 0.8;
    align-items: center;
  }
  .back-btn {
    font-size: 1.6;
    color: #aaaaaa;
    background-color: rgba(100, 100, 100, 0.2);
    border-color: #666666;
    border-width: 0.06;
    border-radius: 0.6;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
