<style>
  .hud-panel {
    display: flex;
    flex-direction: row;
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 2;
    padding-right: 2;
    background-color: rgba(0, 0, 0, 0.7);
    border-color: #ff6600;
    border-width: 0.08;
    border-radius: 0.8;
  }
  .hud-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-left: 1.5;
    margin-right: 1.5;
  }
  .hud-label {
    font-size: 1;
    color: #888888;
  }
  .hud-value {
    font-size: 2.5;
    color: #ff6600;
    font-weight: bold;
  }
  .hud-value-white {
    font-size: 2.5;
    color: #ffffff;
    font-weight: bold;
  }
  .hud-mode {
    font-size: 1.2;
    color: #ffaa44;
  }
  .hud-streak {
    font-size: 1.8;
    color: #ff4400;
    font-weight: bold;
  }
</style>
<div class="hud-panel">
  <div class="hud-col">
    <span class="hud-label">SCORE</span>
    <span id="hud-score" class="hud-value">0</span>
  </div>
  <div class="hud-col">
    <span class="hud-label">SHOTS</span>
    <span id="hud-shots" class="hud-value-white">0/0</span>
  </div>
  <div class="hud-col">
    <span class="hud-label">STREAK</span>
    <span id="hud-streak" class="hud-streak">0</span>
  </div>
  <div class="hud-col">
    <span id="hud-mode" class="hud-mode">FREE THROW</span>
    <span id="hud-info" class="hud-label">--</span>
  </div>
</div>
