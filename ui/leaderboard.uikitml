<style>
  .lb-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 3;
    padding-bottom: 3;
    padding-left: 4;
    padding-right: 4;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #ff6600;
    border-width: 0.12;
    border-radius: 1.5;
  }
  .lb-title {
    font-size: 3;
    color: #ff6600;
    font-weight: bold;
    margin-bottom: 2;
  }
  .lb-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-bottom: 0.4;
  }
  .lb-rank {
    font-size: 1.4;
    color: #ffaa44;
    width: 15%;
  }
  .lb-score {
    font-size: 1.4;
    color: #ffffff;
    width: 35%;
    font-weight: bold;
  }
  .lb-mode {
    font-size: 1.2;
    color: #888888;
    width: 25%;
  }
  .lb-date {
    font-size: 1.2;
    color: #666666;
    width: 25%;
    align-items: flex-end;
  }
  .lb-empty {
    font-size: 1.4;
    color: #666666;
    margin-top: 2;
    margin-bottom: 2;
  }
  .lb-back {
    font-size: 1.6;
    color: #aaaaaa;
    background-color: rgba(100, 100, 100, 0.2);
    border-color: #666666;
    border-width: 0.06;
    border-radius: 0.6;
    padding-top: 0.6;
    padding-bottom: 0.6;
    padding-left: 2;
    padding-right: 2;
    margin-top: 1;
    cursor: pointer;
  }
</style>
