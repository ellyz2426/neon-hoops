<style>
  .ach-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-top: 2;
    padding-bottom: 2;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(0, 0, 0, 0.92);
    border-color: #ff6600;
    border-width: 0.12;
    border-radius: 1.5;
  }
  .ach-title {
    font-size: 2.8;
    color: #ff6600;
    font-weight: bold;
    margin-bottom: 0.5;
  }
  .ach-count {
    font-size: 1.3;
    color: #888888;
    margin-bottom: 1;
  }
  .ach-row {
    display: flex;
    flex-direction: row;
    width: 100%;
    margin-bottom: 0.15;
    padding-bottom: 0.15;
    border-bottom-width: 0.02;
    border-color: rgba(255,102,0,0.15);
  }
  .ach-name {
    font-size: 1.1;
    color: #ffffff;
    width: 40%;
  }
  .ach-desc {
    font-size: 0.95;
    color: #888888;
    width: 48%;
  }
  .ach-status {
    font-size: 1.1;
    color: #ff6600;
    width: 12%;
    align-items: flex-end;
  }
  .ach-back {
    font-size: 1.5;
    color: #aaaaaa;
    background-color: rgba(100, 100, 100, 0.2);
    border-color: #666666;
    border-width: 0.06;
    border-radius: 0.6;
    padding-top: 0.5;
    padding-bottom: 0.5;
    padding-left: 2;
    padding-right: 2;
    margin-top: 0.8;
    cursor: pointer;
  }
</style>
<div class="ach-panel">
  <span class="ach-title">ACHIEVEMENTS</span>
