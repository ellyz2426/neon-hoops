<style>
  .panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 3;
    background-color: rgba(0, 0, 0, 0.9);
    border-color: #ff6600;
    border-width: 0.15;
    border-radius: 1.5;
    gap: 2;
  }
  .title {
    font-size: 3;
    color: #ff6600;
    font-weight: bold;
  }
  .ball-name {
    font-size: 2.2;
    color: #ffffff;
    font-weight: bold;
  }
  .nav-row {
    display: flex;
    flex-direction: row;
    gap: 2;
    align-items: center;
  }
  .nav-btn {
    padding-top: 1.5;
    padding-bottom: 1.5;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(255, 102, 0, 0.3);
    border-color: #ff6600;
    border-width: 0.1;
    border-radius: 0.5;
    cursor: pointer;
  }
  .nav-btn:hover {
    background-color: rgba(255, 102, 0, 0.6);
  }
  .nav-text {
    font-size: 2;
    color: #ff6600;
    font-weight: bold;
  }
  .back-btn {
    padding-top: 1;
    padding-bottom: 1;
    padding-left: 3;
    padding-right: 3;
    background-color: rgba(100, 100, 100, 0.3);
    border-color: #666666;
    border-width: 0.1;
    border-radius: 0.5;
    cursor: pointer;
  }
  .back-btn:hover {
    background-color: rgba(100, 100, 100, 0.6);
  }
  .back-text {
    font-size: 1.5;
    color: #aaaaaa;
  }
  .hint {
    font-size: 1.2;
    color: #666666;
  }
</style>
<div class="panel">
  <span class="title">BALL SKIN</span>
  <span id="ball-name" class="ball-name">Classic Orange</span>
  <div class="nav-row">
    <div id="btn-ball-prev" class="nav-btn" cursor="pointer">
      <span class="nav-text">&lt;</span>
    </div>
    <span class="hint">Select</span>
    <div id="btn-ball-next" class="nav-btn" cursor="pointer">
      <span class="nav-text">&gt;</span>
    </div>
  </div>
  <div id="btn-ball-back" class="back-btn" cursor="pointer">
    <span class="back-text">BACK</span>
  </div>
</div>
